---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import UniversCard from "../components/UniversCard.astro";
import { site } from "../config/site";
import { universPublies as univers } from "../config/univers";
import { largeurEm } from "../lib/anton";

/** Titre d'univers le plus long (em, +2 % de marge) : taille commune des cartes. */
const motEm = Math.max(...univers.map((u) => largeurEm(u.titre))) * 1.02;

const total = String(univers.length).padStart(2, "0");

/** Données structurées Person minimales : ni adresse, ni téléphone. */
const liens: Array<string | null> = [site.links.github, site.links.linkedin];
const sameAs = liens.filter((l): l is string => typeof l === "string");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  url: new URL("/", Astro.site).href,
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<BaseLayout
  description={`Bienvenue dans l'univers de ${site.name} : ${site.presentation.toLowerCase()}. Parcours professionnel, jeux favoris et contact.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <!-- Bannière temporaire : à retirer quand le site sera terminé.
       Le texte défile de gauche à droite ; il n'est lu qu'une fois par les
       lecteurs d'écran (les répétitions sont décoratives). -->
  <div class="chantier on-slab grain-slab" role="note" data-chantier>
    <span class="visually-hidden">Site en cours de développement</span>
    <div class="chantier__piste" aria-hidden="true">
      {
        [0, 1].map(() => (
          <span class="chantier__groupe">
            {Array.from({ length: 8 }, () => (
              <span class="chantier__texte">Site en cours de développement</span>
            ))}
          </span>
        ))
      }
    </div>
    <button type="button" class="chantier__pause" data-chantier-pause hidden>Pause</button>
  </div>
  <Hero />

  <section class="home-univers" aria-labelledby="titre-univers">
    <div class="wrap">
      <header class="section-head">
        <h2 class="section-title" id="titre-univers">Univers</h2>
        <p class="section-count">
          <span class="section-count__n">{total}</span>
          <span class="label">univers</span>
        </p>
      </header>
      <div class="univers">
        {univers.map((u, i) => <UniversCard univers={u} index={i} motEm={motEm} />)}
      </div>
    </div>
  </section>

  <section class="home-contact on-slab grain-slab" aria-labelledby="titre-contact">
    <div class="wrap home-contact__inner">
      <h2 class="home-contact__title" id="titre-contact">Contact</h2>
      <div class="home-contact__body">
        <p class="home-contact__email">{site.email}</p>
        <div class="home-contact__actions">
          <a class="btn btn--inverse" href={`mailto:${site.email}`}>Envoyer un e-mail</a>
          <a class="btn btn--ghost" href="/contact/">Page contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Bouton Pause/Lecture de la bannière (le défilement en continu doit pouvoir être arrêté)
  const banniere = document.querySelector<HTMLElement>("[data-chantier]");
  const bouton = banniere?.querySelector<HTMLButtonElement>("[data-chantier-pause]");
  if (banniere && bouton) {
    bouton.hidden = false;
    bouton.addEventListener("click", () => {
      const pause = banniere.classList.toggle("chantier--pause");
      bouton.textContent = pause ? "Lecture" : "Pause";
    });
  }
</script>

<style>
  /* Bannière « Site en cours de développement » : bandeau bordeaux sous le menu,
     texte répété qui défile de gauche à droite. */
  .chantier {
    position: relative;
    display: flex;
    align-items: center;
    /* Le texte qui sort du bandeau est masqué (aucun défilement de la page) */
    overflow: hidden;
    padding-block: 0.6rem;
  }

  .chantier__piste {
    display: flex;
    flex-shrink: 0;
    width: max-content;
    /* Deux groupes identiques : décaler d'un groupe (-50 %) boucle sans à-coup */
    animation: chantier-defile 45s linear infinite;
  }

  .chantier--pause .chantier__piste {
    animation-play-state: paused;
  }

  @keyframes chantier-defile {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  .chantier__groupe {
    display: flex;
    flex-shrink: 0;
  }

  /* Large espace entre deux occurrences du texte */
  .chantier__texte {
    flex-shrink: 0;
    padding-right: clamp(4rem, 10vw, 8rem);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Bouton Pause, collé au bord droit sur toute la hauteur du bandeau, fond
     plein : le texte disparaît derrière lui (visible seulement avec JavaScript) */
  .chantier__pause {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--gutter);
    border: 0;
    border-left: 1px solid var(--c-on-slab);
    background: var(--c-slab);
    color: var(--c-on-slab);
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* Mouvement réduit demandé : texte immobile, pas de bouton inutile */
  @media (prefers-reduced-motion: reduce) {
    .chantier__piste {
      animation: none;
    }

    .chantier__pause {
      display: none;
    }
  }

  .home-univers {
    padding-block: clamp(3rem, 8vw, 7rem);
    border-top: var(--rule);
  }

  /* Univers à égalité : même largeur, même proportion, donc titres de même
     taille. Téléphone et tablette : une carte par ligne (proportions dans
     UniversCard). Ordinateur : toutes les cartes sur une seule ligne. */
  .univers {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem) clamp(1rem, 3vw, 2.5rem);
  }

  @media (min-width: 64rem) {
    .univers {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
  }

  /* Bloc contact : grand aplat bordeaux */
  .home-contact__inner {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .home-contact__title {
    font-size: clamp(4rem, 2rem + 12vw, 13rem);
    line-height: 0.82;
  }

  .home-contact__email {
    font-size: clamp(1.15rem, 1rem + 1vw, 1.6rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .home-contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .home-contact__inner {
      grid-template-columns: auto 1fr;
      align-items: end;
    }
  }
</style>
