---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import { getProjetsPublies, rang, type Projet } from "../../lib/projets";
import { motLePlusLongEm } from "../../lib/anton";

export const getStaticPaths = (async () => {
  const projets = await getProjetsPublies();
  return projets.map((projet, index) => ({
    params: { slug: projet.id },
    props: {
      projet,
      index,
      total: projets.length,
      suivant: projets[(index + 1) % projets.length]!,
      indexSuivant: (index + 1) % projets.length,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  projet: Projet;
  index: number;
  total: number;
  suivant: Projet;
  indexSuivant: number;
}

const { projet, index, total, suivant, indexSuivant } = Astro.props;
const { data } = projet;
const { Content } = await render(projet);
const aSuivant = total > 1;

// Image de couverture : jamais affichée plus large que sa taille native.
// Avec srcset, le navigateur affiche l'image à la largeur annoncée dans sizes :
// on y annonce donc la largeur native, plafonnée à la largeur disponible.
const coverNative = data.cover.width;
const coverWidths = [480, 720, 960, 1280, 1600].filter((w) => w < coverNative).concat(coverNative);
const coverSizes = `(min-width: ${coverNative + 96}px) ${coverNative}px, calc(100vw - 2 * clamp(1rem, 4vw, 3rem))`;
---

<BaseLayout title={data.title} description={`${data.title} : ${data.summary} Projet de ${site.name}, ${site.role}.`}>
  <article class="projet">
    <!-- --mot-em : largeur du mot le plus long du titre (+2 % de marge), pour
         qu'il tienne toujours sur une ligne à côté du numéro -->
    <header class="wrap projet__head" style={`--mot-em: ${(motLePlusLongEm(data.title) * 1.02).toFixed(3)}`}>
      <p class="projet__num">{rang(index)}</p>
      <h1 class:list={["projet__title", { "projet__title--long": data.title.length > 18 }]}>{data.title}</h1>
      <p class="projet__summary">{data.summary}</p>
    </header>

    <div class="wrap projet__sheet">
      <dl class="projet__facts">
        <div>
          <dt class="label">Rôle</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt class="label">Technologies</dt>
          <dd>
            <ul class="projet__tech" role="list">
              {data.technologies.map((tech) => <li>{tech}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <div class="wrap">
      <figure class="projet__cover crop-marks" style={`--cover-native: ${coverNative}px`}>
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={coverWidths}
          sizes={coverSizes}
          loading="eager"
          fetchpriority="high"
          format="webp"
          quality={88}
        />
      </figure>
      {
        data.coverZoom && (
          <p class="projet__zoom">
            <a class="link-arrow" href={data.cover.src}>
              Voir l'image en taille réelle
            </a>
          </p>
        )
      }
    </div>

    <div class="wrap projet__body">
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      data.images.length > 0 && (
        <section class="wrap projet__gallery" aria-labelledby="titre-images">
          <h2 id="titre-images" class="projet__section-title">
            Images
          </h2>
          <div class="gallery">
            {data.images.map((img) => (
              <figure class="gallery__item">
                <div class="reveal">
                  <Image
                    src={img.src}
                    alt={img.alt}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 48rem) 60vw, 100vw"
                    loading="lazy"
                    format="webp"
                    quality={88}
                  />
                </div>
                {img.caption && <figcaption class="label">{img.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      data.documents.length > 0 && (
        <section class="wrap projet__docs" aria-labelledby="titre-documents">
          <h2 id="titre-documents" class="projet__section-title">
            Documents
          </h2>
          <ul class="docs" role="list">
            {data.documents.map((doc) => (
              <li>
                <a class="docs__link" href={doc.file} download>
                  <span>{doc.title}</span>
                  <span class="label">PDF — Télécharger</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="wrap">
    <nav class="projet__nav" aria-label="Autres projets">
      <a class="link-arrow" href="/pro/#projets">Tous les projets</a>
      {
        aSuivant && (
          <a class="projet__next" href={`/projets/${suivant.id}/`}>
            <span class="label">Projet suivant · {rang(indexSuivant)}</span>
            <span class="projet__next-title">{suivant.data.title}</span>
          </a>
        )
      }
    </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .projet {
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  /* ============ En-tête : numéro de piste + grand titre ============ */
  /* En-tête : numéro à gauche du titre ; la suite du titre et le résumé
     s'alignent sous le début du titre. */
  .projet__head {
    --fn: clamp(1.75rem, 1rem + 2.5vw, 3rem);
    --gap: 0.75rem;
    --ft-base: clamp(2rem, 0.6rem + 7vw, 8rem);
    /* Le mot le plus long tient toujours sur une ligne, à côté du numéro
       (largeur du numéro « 01 » à « 99 » : au plus 1 em) */
    --ft: min(var(--ft-base), calc((100cqi - var(--fn) - var(--gap)) / var(--mot-em)));
    container-type: inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--gap);
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  /* Haut des chiffres aligné sur le haut des capitales du titre (métriques
     d'Anton, src/lib/anton.ts) : titre 0,1745 × taille + 1 px ; numéro
     (interligne 1) 0,0645 × taille. */
  .projet__num {
    grid-column: 1;
    grid-row: 1;
    margin: calc(0.1745 * var(--ft) + 1px - 0.0645 * var(--fn)) 0 0;
    font-family: var(--font-display-stack);
    font-size: var(--fn);
    line-height: 1;
    color: var(--c-mark);
    white-space: nowrap;
  }

  /* Aucune césure : un mot n'est jamais coupé (vérifié par les tests). */
  .projet__title {
    grid-column: 2;
    max-width: 11em;
    font-size: var(--ft);
    line-height: var(--lh-title);
  }

  /* Titre long : 25 % plus petit sur ordinateur, sur une largeur un peu plus
     grande (deux lignes au lieu de trois), pour que le titre et le résumé
     laissent voir le début de la fiche dès le premier écran. */
  @media (min-width: 64rem) {
    .projet__head:has(.projet__title--long) {
      --ft-base: min(calc(0.75 * (0.6rem + 7vw)), 6rem);
    }

    .projet__title--long {
      max-width: 15em;
    }
  }

  .projet__summary {
    grid-column: 2;
    max-width: 40ch;
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
  }

  /* ============ Fiche : rôle, technologies ============ */
  .projet__sheet {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .projet__facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: var(--rule);
  }

  .projet__facts div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--c-fg);
  }

  .projet__facts dd {
    margin: 0;
  }

  /* Technologies en colonnes, sans séparateur (aucun « / » isolé en fin de ligne) */
  .projet__tech {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 0.2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projet__tech li::before {
    content: "";
    display: inline-block;
    width: 0.6rem;
    height: 2px;
    margin-right: 0.55rem;
    vertical-align: middle;
    background: var(--c-mark);
  }

  @media (min-width: 48rem) {
    .projet__facts div {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
    }
  }

  /* ============ Image de couverture ============
     Alignée sur le bord gauche du contenu, à ses proportions d'origine
     (aucun recadrage ni déformation), et jamais plus haute que la fenêtre.
     Effet éditorial : traits de coupe aux quatre coins. */
  .projet__cover {
    width: fit-content;
    max-width: 100%;
    margin: clamp(2.5rem, 6vw, 5rem) 0 0;
    color: var(--c-fg);
  }

  .projet__cover img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, var(--cover-native, 100%));
    max-height: min(78svh, 60rem);
    filter: grayscale(1) contrast(1.05);
  }

  .projet__zoom {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  /* ============ Texte : colonne décalée (asymétrie) ============ */
  /* Texte aligné sur le bord gauche de l'image (et du contenu),
     colonne limitée à 64 caractères pour une lecture confortable. */
  .projet__body {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .projet__section-title {
    margin-bottom: 1.5rem;
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
  }

  /* ============ Images ============ */
  .projet__gallery,
  .projet__docs {
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .gallery {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__item img {
    width: 100%;
    filter: grayscale(1) contrast(1.05);
  }

  .gallery__item figcaption {
    margin-top: 0.6rem;
  }

  @media (min-width: 48rem) {
    .gallery__item:nth-child(odd) {
      width: 66%;
    }

    .gallery__item:nth-child(even) {
      width: 50%;
      margin-left: auto;
    }
  }

  /* ============ Documents ============ */
  .docs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule);
  }

  .docs__link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-fg);
    font-weight: 600;
    text-decoration: none;
  }

  .docs__link:hover .label {
    text-decoration: underline;
  }

  /* ============ Navigation entre projets ============ */
  .projet__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-top: 1.25rem;
    border-top: var(--rule);
  }

  .projet__next {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .projet__next {
      margin-left: auto;
      text-align: right;
    }
  }

  .projet__next-title {
    font-family: var(--font-display-stack);
    font-size: clamp(2rem, 1.4rem + 3vw, 4.5rem);
    line-height: var(--lh-title);
    text-transform: uppercase;
    /* Lignes équilibrées : jamais un mot seul en dernière ligne */
    text-wrap: balance;
  }

  .projet__next:hover .projet__next-title {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }
</style>
