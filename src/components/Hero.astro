---
import { Image } from "astro:assets";
import { site } from "../config/site";
import { heroPhoto } from "../lib/photo";

const [prenom, ...reste] = site.name.split(" ");
const nom = reste.join(" ");

// Proportions réelles de la photo, et largeur d'affichage maximale :
// 62 % de sa largeur native (838 px → 519 px, soit 720 px de haut).
// Jamais affichée au-delà de sa résolution native.
const PHOTO_MAX_RATIO = 0.62;
const photoMax = Math.round(heroPhoto.src.width * PHOTO_MAX_RATIO);
const photoStyle = `--photo-ratio: ${heroPhoto.src.width} / ${heroPhoto.src.height}; --photo-max: ${photoMax}px;`;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap hero__wrap">
    <div class="hero__stage" style={photoStyle}>
      <div class="hero__intro">
        <p class="hero__kicker label">Portfolio</p>
        <p class="hero__role">{site.role}</p>
      </div>

      <h1 class="hero__name" id="hero-name">
        <span class="hero__name-inner"
          ><span class="hero__line">{prenom}</span>{" "}<span class="hero__line">{nom}</span></span
        >
      </h1>

      <!-- Aplat bordeaux : le portrait se termine toujours sur son bord bas -->
      <div class="hero__slab grain-slab" aria-hidden="true">
        <span class="hero__caption label">{heroPhoto.temporaire ? "Visuel temporaire" : "Portrait"}</span>
      </div>

      <figure class="hero__figure">
        <Image
          src={heroPhoto.src}
          alt={heroPhoto.alt}
          widths={[320, 480, 640, heroPhoto.src.width]}
          sizes={`(min-width: 48rem) ${photoMax}px, 58vw`}
          loading="eager"
          fetchpriority="high"
          format="webp"
          quality={80}
        />
      </figure>

      <div class="hero__info">
        <ul class="hero__facts" role="list">
          <li><span class="hero__fact-label">Région&nbsp;:</span> {site.location}</li>
          <li>{site.availability}</li>
        </ul>
        <div class="hero__actions">
          <a class="btn" href={site.cvPath} download>
            Télécharger le CV <span class="hero__format">PDF</span>
          </a>
          <a class="btn btn--ghost" href="/contact/">Contact</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
  }

  /* Le héros occupe toute la largeur de l'écran, même au-delà de 1440 px */
  .hero__wrap {
    max-width: none;
  }

  /* =====================================================================
     Scène : grille 12 colonnes. Le conteneur sert de référence (cqi)
     pour que le nom remplisse exactement la largeur utile.
     ===================================================================== */
  .hero__stage {
    container-type: inline-size;
    /* Largeur du nom en em, mesurée avec Anton (6,674 et 4,557) + ~1,5 % de marge */
    --k-one: 6.78;
    --k-two: 4.63;
    --lh: 0.92;
    --name-size: calc(100cqi / var(--k-two));
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto auto auto;
    padding-top: clamp(1.25rem, 4vw, 3rem);
  }

  /* ============ Nom : centré, donc marges gauche et droite égales ============ */
  .hero__name {
    grid-column: 1 / -1;
    grid-row: 2;
    z-index: 1;
    margin: 0;
    font-size: var(--name-size);
    line-height: var(--lh);
    text-align: center;
    white-space: nowrap;
    /* La zone des glyphes d'Anton dépasse la ligne : elle ne doit jamais
       intercepter un clic ni passer devant les informations. */
    pointer-events: none;
  }

  .hero__name-inner {
    display: inline-block;
    text-align: left;
  }

  .hero__line {
    display: block;
  }

  /* ============ Aplat + portrait (téléphone) ============
     Le portrait s'arrête sur le haut de la ligne « CARDAMONE »,
     exactement sur le bord bas de l'aplat : pas de coupe dans les lettres. */
  .hero__slab {
    position: relative;
    grid-column: 7 / -1;
    grid-row: 1 / 3;
    margin-top: calc(var(--name-size) * 0.55);
    margin-right: calc(-1 * var(--gutter));
    margin-bottom: calc(var(--name-size) * (var(--lh) + 0.04));
  }

  .hero__figure {
    grid-column: 6 / -1;
    grid-row: 1 / 3;
    z-index: 2;
    align-self: end;
    margin: 0 0 calc(var(--name-size) * (var(--lh) + 0.04));
    /* Proportions réelles de la photo (définies dans le composant) */
    aspect-ratio: var(--photo-ratio, 4 / 5);
    max-width: var(--photo-max, none);
    width: 100%;
    justify-self: center;
    color: var(--c-fg);
  }

  /* La photo est calée en bas du cadre : sa coupe tombe sur le bord de l'aplat.
     Elle est déjà en noir et blanc avec grain (npm run prepare:photo). */
  .hero__figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }

  /* Légende verticale, façon crédit photo de lookbook */
  .hero__caption {
    display: none;
    position: absolute;
    right: calc(var(--gutter) / 2);
    bottom: 1rem;
    transform: translateX(50%) rotate(180deg);
    writing-mode: vertical-rl;
    color: var(--c-on-slab);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  /* ============ Informations (jamais recouvertes) ============ */
  /* Les informations passent toujours au premier plan */
  .hero__intro,
  .hero__info {
    position: relative;
    z-index: 3;
  }

  .hero__intro {
    grid-column: 1 / -1;
    grid-row: 3;
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .hero__kicker {
    margin-bottom: 0.6rem;
  }

  .hero__role {
    max-width: 24ch;
    margin: 0;
    font-size: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .hero__info {
    grid-column: 1 / -1;
    grid-row: 4;
    padding-top: 1.25rem;
    padding-bottom: clamp(2rem, 6vw, 3rem);
  }

  .hero__facts {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .hero__facts li {
    max-width: 52ch;
    padding-top: 0.6rem;
    border-top: 1px solid var(--c-fg);
  }

  .hero__fact-label {
    margin-right: 0.2em;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__format {
    font-size: 0.75em;
    letter-spacing: 0.08em;
  }

  /* =====================================================================
     Tablette et ordinateur : le nom traverse le héros, derrière la tête
     du portrait ; le buste descend jusqu'au bas de l'aplat (= bas du héros).
     ===================================================================== */
  @media (min-width: 48rem) {
    .hero__stage {
      --name-size: calc(100cqi / var(--k-one));
      --lh: 0.86;
      grid-template-rows: auto auto 1fr;
      padding-top: clamp(2rem, 5vw, 4.5rem);
    }

    .hero__line {
      display: inline;
    }

    .hero__intro {
      grid-column: 1 / 7;
      grid-row: 1;
      align-self: end;
      padding-top: 0;
      padding-bottom: calc(var(--name-size) * 0.14);
    }

    .hero__info {
      grid-column: 1 / 7;
      grid-row: 3;
      padding-top: calc(var(--name-size) * 0.16);
      padding-right: 1.5rem;
      padding-bottom: clamp(2rem, 4vw, 3rem);
    }

    /* Aplat resserré autour du portrait (4rem de marge à gauche), à fond perdu
       à droite, sans jamais dépasser sa zone (colonnes 7 à 12). */
    .hero__slab {
      grid-column: 7 / -1;
      grid-row: 3;
      justify-self: end;
      width: min(calc(100% + var(--gutter)), calc(min(43cqi, var(--photo-max, 100cqi)) + 4rem + var(--gutter)));
      margin-top: 0;
      margin-bottom: 0;
    }

    .hero__caption {
      display: block;
    }

    /* Portrait : 43 % de la scène, plafonné à --photo-max (≈ 720 px de haut).
       Il occupe toute la hauteur du héros, collé en bas et calé à droite :
       le haut de la tête ne peut pas être coupé (le héros grandit au besoin)
       et le nom, dans la 2e rangée, passe derrière le visage.
       Les informations restent dans la moitié gauche (colonnes 1 à 6). */
    .hero__figure {
      grid-column: 7 / -1;
      grid-row: 1 / 4;
      justify-self: end;
      width: min(43cqi, var(--photo-max, 100cqi));
      margin: 0;
    }
  }

  /* ============ Animations (uniquement si JavaScript est actif) ============ */
  :global(.js) .hero__line {
    animation: hero-rise 0.9s var(--ease-out) both;
  }

  :global(.js) .hero__line + .hero__line {
    animation-delay: 0.08s;
  }

  :global(.js) .hero__slab {
    transform-origin: bottom;
    animation: hero-slab 0.8s var(--ease-out) both;
  }

  :global(.js) .hero__figure img {
    animation: hero-photo 1s 0.15s var(--ease-out) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }

  @keyframes hero-slab {
    from {
      transform: scaleY(0);
    }
  }

  /* Croissance depuis le bas du cadre : la photo ne dépasse jamais l'aplat */
  @keyframes hero-photo {
    from {
      opacity: 0;
      transform: scale(0.96);
      transform-origin: 50% 100%;
    }
  }
</style>
