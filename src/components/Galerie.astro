---
/**
 * Galerie de photos optimisées (astro:assets), sans bibliothèque externe.
 * - Sans JavaScript : chaque vignette est un lien vers la photo agrandie.
 * - Avec JavaScript : la photo s'ouvre dans une fenêtre <dialog> native
 *   (Échap ou « Fermer » pour sortir, flèches ou boutons pour naviguer) ;
 *   le focus revient sur la vignette à la fermeture.
 * Les images générées ne contiennent aucune métadonnée (EXIF, GPS).
 */
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

interface Props {
  photos: { src: ImageMetadata; alt: string; legende: string }[];
}

const { photos } = Astro.props;
const grandes = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 1800), format: "webp", quality: 85 })),
);
---

{
  photos.length > 0 && (
    <div class="galerie" data-galerie>
      <ul class="galerie__liste" role="list">
        {photos.map((photo, i) => (
          <li class="galerie__item">
            <div class="galerie__cadre crop-marks">
            <a class="galerie__lien" href={grandes[i]!.src} data-index={i} data-alt={photo.alt} data-legende={photo.legende}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 640, 960].filter((w) => w < photo.src.width).concat(Math.min(photo.src.width, 1280))}
                sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
                loading="lazy"
                format="webp"
                quality={80}
              />
              <span class="visually-hidden"> (agrandir la photo)</span>
            </a>
            </div>
            {photo.legende && <p class="galerie__legende">{photo.legende}</p>}
          </li>
        ))}
      </ul>

      <dialog class="visionneuse" aria-label="Photo agrandie" data-visionneuse>
        <!-- L'image est créée par le script : sans JavaScript, aucune image vide dans la page -->
        <figure class="visionneuse__figure">
          <div class="visionneuse__cadre" data-visionneuse-cadre></div>
          <figcaption class="visionneuse__legende" data-visionneuse-legende />
        </figure>
        <div class="visionneuse__barre">
          <p class="visionneuse__compteur" data-visionneuse-compteur aria-live="polite" />
          <div class="visionneuse__boutons">
            <button type="button" class="btn btn--ghost" data-visionneuse-prec>Précédente</button>
            <button type="button" class="btn btn--ghost" data-visionneuse-suiv>Suivante</button>
            <button type="button" class="btn" data-visionneuse-fermer autofocus>Fermer</button>
          </div>
        </div>
      </dialog>
    </div>
  )
}

<script>
  for (const galerie of document.querySelectorAll<HTMLElement>("[data-galerie]")) {
    const dialog = galerie.querySelector<HTMLDialogElement>("[data-visionneuse]");
    if (!dialog || typeof dialog.showModal !== "function") continue; // sans <dialog> : simples liens
    const liens = [...galerie.querySelectorAll<HTMLAnchorElement>(".galerie__lien")];
    const img = document.createElement("img");
    img.className = "visionneuse__img";
    img.alt = "";
    dialog.querySelector("[data-visionneuse-cadre]")!.append(img);
    const legende = dialog.querySelector<HTMLElement>("[data-visionneuse-legende]")!;
    const compteur = dialog.querySelector<HTMLElement>("[data-visionneuse-compteur]")!;
    const prec = dialog.querySelector<HTMLButtonElement>("[data-visionneuse-prec]")!;
    const suiv = dialog.querySelector<HTMLButtonElement>("[data-visionneuse-suiv]")!;
    let courant = 0;

    const afficher = (i: number) => {
      courant = (i + liens.length) % liens.length;
      const lien = liens[courant]!;
      img.src = lien.href;
      img.alt = lien.dataset.alt ?? "";
      legende.textContent = lien.dataset.legende ?? "";
      legende.hidden = !lien.dataset.legende;
      compteur.textContent = `Photo ${courant + 1} sur ${liens.length}`;
    };

    const unique = liens.length < 2;
    prec.hidden = unique;
    suiv.hidden = unique;

    liens.forEach((lien, i) =>
      lien.addEventListener("click", (e) => {
        // Ctrl/Cmd-clic ou clic du milieu : comportement normal du lien
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        afficher(i);
        dialog.showModal();
      }),
    );
    prec.addEventListener("click", () => afficher(courant - 1));
    suiv.addEventListener("click", () => afficher(courant + 1));
    dialog.querySelector("[data-visionneuse-fermer]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("keydown", (e) => {
      if (unique) return;
      if (e.key === "ArrowLeft") afficher(courant - 1);
      if (e.key === "ArrowRight") afficher(courant + 1);
    });
    // Clic sur le fond sombre : fermeture
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    // À la fermeture (Échap compris), le focus revient sur la photo affichée
    dialog.addEventListener("close", () => liens[courant]?.focus());
  }
</script>

<style>
  /* Écart entre photos assez large pour les repères de coupe (≤ 1,2 rem
     de chaque côté) : ils ne se chevauchent pas et ne débordent jamais. */
  .galerie__liste {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .galerie__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .galerie__liste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .galerie__lien {
    display: block;
    cursor: zoom-in;
  }

  .galerie__lien img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.25s var(--ease-out);
  }

  .galerie__lien:hover img {
    opacity: 0.85;
  }

  /* Sous les repères de coupe du bas (1,2 rem au plus) */
  .galerie__legende {
    margin: 1.4rem 0 0;
    font-size: 0.875rem;
  }

  /* ============ Visionneuse ============ */
  .visionneuse {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 3vw, 2rem);
    border: 0;
    background: #111110;
    color: #f2f0eb;
  }

  .visionneuse[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
  }

  .visionneuse::backdrop {
    background: rgb(17 17 16 / 0.9);
  }

  .visionneuse__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.75rem;
    min-height: 0;
    margin: 0;
  }

  /* Cadre de taille fixe (la place restante) : la photo s'y ajuste entière,
     sans jamais recouvrir la légende ni les boutons. */
  .visionneuse__cadre {
    position: relative;
    min-height: 0;
  }

  .visionneuse__cadre :global(.visionneuse__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .visionneuse__legende {
    font-size: 0.875rem;
    text-align: center;
  }

  .visionneuse__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .visionneuse__compteur {
    margin: 0;
    font-size: 0.875rem;
  }

  .visionneuse__boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Boutons lisibles sur le fond sombre, dans les deux thèmes */
  .visionneuse .btn {
    --btn-bg: #f2f0eb;
    --btn-fg: #111110;
  }

  .visionneuse .btn--ghost {
    border-color: #f2f0eb;
    color: #f2f0eb;
  }

  .visionneuse :focus-visible {
    outline-color: #f2f0eb;
  }
</style>
